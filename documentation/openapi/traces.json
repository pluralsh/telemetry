{
  "openapi": "3.1.0",
  "info": {
    "title": "Traces HTTP API",
    "description": "Tempo-compatible trace query and OTLP/Zipkin HTTP ingestion API. OTLP and Jaeger gRPC services are documented separately.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/-/healthy": {
      "get": {
        "tags": [
          "operations"
        ],
        "operationId": "healthy",
        "responses": {
          "200": {
            "description": "Process is healthy"
          }
        }
      }
    },
    "/-/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Server is ready"
          },
          "503": {
            "description": "Assigned shards are not ready"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/echo": {
      "get": {
        "tags": [
          "operations"
        ],
        "operationId": "echo",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo-compatible echo"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/metrics/query_range": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "metrics_query_range",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "501": {
            "description": "TraceQL metrics are not implemented"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/search": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "search",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "TraceQL expression",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Legacy key=value selector",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Unix seconds",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "Unix seconds",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching trace summaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid TraceQL query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/read/ns/{namespace}/api/search/tag/{name}/values": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "tag_values_legacy",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo tag values"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/search/tags": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "tag_names_legacy",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo tag names"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/traces/{trace_id}": {
      "get": {
        "tags": [
          "traces"
        ],
        "operationId": "trace_v1",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "trace_id",
            "in": "path",
            "description": "32-character hexadecimal trace ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo v1 trace response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceResponse"
                }
              },
              "application/x-protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/BinaryBody"
                }
              }
            }
          },
          "404": {
            "description": "Trace not found"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/v1/tag/{name}/values": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "tag_values_v1",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo v1 tag values"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/v1/tags": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "tag_names_v1",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo v1 tag names"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/v2/search/tag/{name}/values": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "tag_values_v2",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo v2 tag values"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/v2/search/tags": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "tag_names_v2",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo v2 tag names"
          }
        }
      }
    },
    "/read/ns/{namespace}/api/v2/traces/{trace_id}": {
      "get": {
        "tags": [
          "traces"
        ],
        "operationId": "trace_v2",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "trace_id",
            "in": "path",
            "description": "32-character hexadecimal trace ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tempo v2 trace response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceResponse"
                }
              },
              "application/x-protobuf": {
                "schema": {
                  "$ref": "#/components/schemas/BinaryBody"
                }
              }
            }
          },
          "404": {
            "description": "Trace not found"
          }
        }
      }
    },
    "/write/ns/{namespace}/api/v2/spans": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "zipkin_spans",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ZipkinSpan"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Zipkin spans accepted"
          },
          "400": {
            "description": "Invalid Zipkin request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/write/ns/{namespace}/v1/traces": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "otlp_traces",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "description": "Configured tenant namespace",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "OTLP ExportTraceServiceRequest.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonBody"
              }
            },
            "application/x-protobuf": {
              "schema": {
                "$ref": "#/components/schemas/BinaryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTLP traces accepted"
          },
          "400": {
            "description": "Invalid OTLP request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds configured limit"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BinaryBody": {
        "type": "string",
        "format": "binary"
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "JsonBody": {
        "type": "object"
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "traces"
        ],
        "properties": {
          "traces": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "TraceResponse": {
        "type": "object",
        "required": [
          "batches"
        ],
        "properties": {
          "batches": {
            "type": "object"
          }
        }
      },
      "ZipkinAnnotation": {
        "type": "object",
        "required": [
          "timestamp",
          "value"
        ],
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "value": {
            "type": "string"
          }
        }
      },
      "ZipkinEndpoint": {
        "type": "object",
        "properties": {
          "ipv4": {
            "type": [
              "string",
              "null"
            ]
          },
          "ipv6": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "serviceName": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ZipkinSpan": {
        "type": "object",
        "required": [
          "traceId",
          "id"
        ],
        "properties": {
          "annotations": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ZipkinAnnotation"
            }
          },
          "duration": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "localEndpoint": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ZipkinEndpoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "remoteEndpoint": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ZipkinEndpoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "traceId": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "traces",
      "description": "Trace lookup"
    },
    {
      "name": "search",
      "description": "TraceQL and tag discovery"
    },
    {
      "name": "ingest",
      "description": "OTLP and Zipkin ingestion"
    },
    {
      "name": "operations",
      "description": "Health, readiness, and compatibility"
    }
  ]
}
