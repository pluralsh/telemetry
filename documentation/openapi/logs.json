{
  "openapi": "3.1.0",
  "info": {
    "title": "Logs HTTP API",
    "description": "Loki-compatible LogQL query and log ingestion API.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/-/healthy": {
      "get": {
        "tags": [
          "operations"
        ],
        "operationId": "healthy",
        "responses": {
          "200": {
            "description": "Process is healthy"
          }
        }
      }
    },
    "/-/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Server is ready"
          },
          "503": {
            "description": "Assigned shards are not ready"
          }
        }
      }
    },
    "/read/ns/{namespace}/loki/api/v1/label/{name}/values": {
      "get": {
        "tags": [
          "metadata"
        ],
        "operationId": "label_values",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "Stream-label name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sorted values for the stream label",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LokiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid time range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/read/ns/{namespace}/loki/api/v1/labels": {
      "get": {
        "tags": [
          "metadata"
        ],
        "operationId": "label_names",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Range start as nanoseconds, seconds, or RFC3339",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "Range end as nanoseconds, seconds, or RFC3339",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Default lookback when start is omitted",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sorted stream-label names",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LokiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid time range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/read/ns/{namespace}/loki/api/v1/query": {
      "get": {
        "tags": [
          "query"
        ],
        "operationId": "query_get",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "description": "Configured tenant namespace",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "description": "LogQL expression",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "direction",
            "in": "query",
            "description": "forward or backward",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Loki query response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LokiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unknown namespace"
          }
        }
      },
      "post": {
        "tags": [
          "query"
        ],
        "operationId": "query_post",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Loki query response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LokiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/read/ns/{namespace}/loki/api/v1/query_range": {
      "get": {
        "tags": [
          "query"
        ],
        "operationId": "query_range_get",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "description": "LogQL expression",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Loki range-query response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LokiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "query"
        ],
        "operationId": "query_range_post",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Loki range-query response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LokiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/read/ns/{namespace}/loki/api/v1/series": {
      "get": {
        "tags": [
          "metadata"
        ],
        "operationId": "series_get",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "match[]",
            "in": "query",
            "description": "One or more Loki stream selectors",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching stream label sets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LokiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid selector or time range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "post": {
        "tags": [
          "metadata"
        ],
        "operationId": "series_post",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Matching stream label sets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LokiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid selector or time range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/write/ns/{namespace}/elasticsearch": {
      "get": {
        "tags": [
          "ingest"
        ],
        "operationId": "elasticsearch_info",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Elasticsearch version handshake",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/write/ns/{namespace}/elasticsearch/_bulk": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "elasticsearch_bulk",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_msg_field",
            "in": "query",
            "description": "Comma-separated message fields; overrides configuration",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_time_field",
            "in": "query",
            "description": "Timestamp field; overrides configuration",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_stream_fields",
            "in": "query",
            "description": "Comma-separated document fields promoted to stream labels",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Elasticsearch bulk NDJSON. `index` and `create` actions are ingested; `update` and `delete` fail per item.",
          "content": {
            "application/x-ndjson": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Per-item bulk results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed bulk body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds configured limit"
          }
        }
      }
    },
    "/write/ns/{namespace}/elasticsearch/_cluster/health": {
      "get": {
        "tags": [
          "ingest"
        ],
        "operationId": "elasticsearch_cluster_health",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Always green",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/write/ns/{namespace}/elasticsearch/{index}/_bulk": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "elasticsearch_index_bulk",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "index",
            "in": "path",
            "description": "Default index for actions without `_index`",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_msg_field",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_time_field",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_stream_fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-ndjson": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Per-item bulk results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed bulk body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds configured limit"
          }
        }
      }
    },
    "/write/ns/{namespace}/loki/api/v1/push": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "loki_push",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Loki push JSON or Snappy-compressed protobuf.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LokiPush"
              }
            },
            "application/x-protobuf": {
              "schema": {
                "$ref": "#/components/schemas/BinaryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Logs accepted"
          },
          "400": {
            "description": "Invalid push request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds configured limit"
          }
        }
      }
    },
    "/write/ns/{namespace}/otlp/v1/logs": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "otlp_logs",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "OTLP ExportLogsServiceRequest.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonBody"
              }
            },
            "application/x-protobuf": {
              "schema": {
                "$ref": "#/components/schemas/BinaryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTLP logs accepted"
          },
          "400": {
            "description": "Invalid OTLP request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds configured limit"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BinaryBody": {
        "type": "string",
        "format": "binary"
      },
      "BulkResponse": {
        "type": "object",
        "required": [
          "took",
          "errors",
          "items"
        ],
        "properties": {
          "errors": {
            "type": "boolean",
            "description": "True when at least one item failed."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "One `{action: {_index, _id, status, ...}}` object per bulk action, in request order."
          },
          "took": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "JsonBody": {
        "type": "object"
      },
      "LokiEnvelope": {
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "LokiPush": {
        "type": "object",
        "required": [
          "streams"
        ],
        "properties": {
          "streams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LokiStream"
            }
          }
        }
      },
      "LokiStream": {
        "type": "object",
        "required": [
          "stream",
          "values"
        ],
        "properties": {
          "stream": {
            "type": "object",
            "description": "Stream labels.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "description": "Loki `[timestamp_ns, line, optional_metadata]` tuples."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "query",
      "description": "LogQL query"
    },
    {
      "name": "metadata",
      "description": "Stream-label discovery"
    },
    {
      "name": "ingest",
      "description": "Loki, OTLP, and Elasticsearch bulk ingestion"
    },
    {
      "name": "operations",
      "description": "Health and readiness"
    }
  ]
}
