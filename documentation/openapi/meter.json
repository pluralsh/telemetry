    "/write/ns/{namespace}/api/v1/write": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "remote_write",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Snappy-compressed Prometheus remote-write request: `prometheus.WriteRequest` (1.0, default) or `io.prometheus.write.v2.Request` when the content type carries `proto=io.prometheus.write.v2.Request`. Both carry native histograms.",
          "content": {
            "application/x-protobuf": {
              "schema": {
                "$ref": "#/components/schemas/BinaryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Write accepted; 2.0 requests also receive X-Prometheus-Remote-Write-{Samples,Histograms,Exemplars}-Written headers"
          },
          "400": {
            "description": "Invalid remote-write request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported remote-write protobuf message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/write/ns/{namespace}/v1/metrics": {
      "post": {
        "tags": [
          "ingest"
        ],
        "operationId": "otlp_metrics",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "OTLP ExportMetricsServiceRequest",
          "content": {
            "application/x-protobuf": {
              "schema": {
                "$ref": "#/components/schemas/BinaryBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTLP metrics accepted"
          },
          "400": {
            "description": "Invalid OTLP request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiEnvelope": {
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          },
          "status": {
            "type": "string",
            "description": "Prometheus response status (`success` or `error`)."
          }
        }
      },
      "BinaryBody": {
        "type": "string",
        "format": "binary"
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "error_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "query",
      "description": "PromQL and federation"
    },
    {
      "name": "metadata",
      "description": "Series and label discovery"
    },
    {
      "name": "ingest",
      "description": "Prometheus and OTLP ingestion"
    },
    {
      "name": "operations",
      "description": "Health and server telemetry"
    }
  ]
}
