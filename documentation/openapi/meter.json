{
  "openapi": "3.1.0",
  "info": {
    "title": "Meter HTTP API",
    "description": "Prometheus-compatible query and ingestion API. Configure path_prefix to prepend a common prefix to data routes.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/-/healthy": {
      "get": {
        "tags": [
          "operations"
        ],
        "operationId": "healthy",
        "responses": {
          "200": {
            "description": "Process is healthy"
          }
        }
      }
    },
    "/-/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Server is ready"
          },
          "503": {
            "description": "Assigned shards are not ready"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "operations"
        ],
        "operationId": "metrics",
        "responses": {
          "200": {
            "description": "Server metrics",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/read/ns/{namespace}/api/v1/label/{name}/values": {
      "get": {
        "tags": [
          "metadata"
        ],
        "operationId": "label_values",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "Label name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "match[]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Label values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/read/ns/{namespace}/api/v1/labels": {
      "get": {
        "tags": [
          "metadata"
        ],
        "operationId": "labels",
