    "/read/ns/{namespace}/federate": {
      "get": {
        "tags": [
          "query"
        ],
        "operationId": "federate",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "match[]",
            "in": "query",
            "description": "Series selectors",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
