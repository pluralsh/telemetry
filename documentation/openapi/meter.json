                }
              }
            }
          }
        }
      }
    },
    "/read/ns/{namespace}/api/v1/series": {
      "get": {
        "tags": [
          "metadata"
        ],
        "operationId": "series_get",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "match[]",
            "in": "query",
            "description": "Series selectors",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end",
            "in": "query",
